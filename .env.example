# Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://opensoar:opensoar@localhost:5432/opensoar

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key-change-this

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Optional: External connector settings (for future real integrations)
# SLACK_WEBHOOK_URL=
# SMTP_SERVER=
# SMTP_PORT=
